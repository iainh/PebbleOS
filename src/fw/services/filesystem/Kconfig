config SERVICE_FILESYSTEM
    bool "Filesystem"
    help
      Pebble filesystem (PFS) service.

if SERVICE_FILESYSTEM

config PFS_RUST
    bool "Rust PFS implementation"
    select CRC32_RUST
    help
      Replace the C Pebble filesystem with the transactional Rust implementation.

module = SERVICE_FILESYSTEM
module-str = Filesystem
source "subsys/logging/Kconfig.template.log_level"

endif
